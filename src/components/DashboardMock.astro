---
---

<div class="dashboard-mock">
  <div class="window-chrome">
    <div class="window-controls">
      <span class="dot close"></span>
      <span class="dot minimize"></span>
      <span class="dot expand"></span>
    </div>
    <div class="window-title">Pulse Dashboard</div>
  </div>

  <div class="dashboard-content">
    <div class="section status-overview">
      <div class="status-card">
        <div class="card-header">
          <span class="api-name">Users API</span>
          <div class="status-indicator healthy">
            <span class="pulse-ring"></span>
            <span class="pulse-dot"></span>
          </div>
        </div>
        <div class="metrics">
          <span class="metric-label">Latency</span>
          <span class="metric-value">23ms</span>
        </div>
      </div>
      
      <div class="status-card">
        <div class="card-header">
          <span class="api-name">Payments API</span>
          <div class="status-indicator healthy">
            <span class="pulse-ring"></span>
            <span class="pulse-dot"></span>
          </div>
        </div>
        <div class="metrics">
          <span class="metric-label">Latency</span>
          <span class="metric-value">45ms</span>
        </div>
      </div>

      <div class="status-card warning">
        <div class="card-header">
          <span class="api-name">Search API</span>
          <div class="status-indicator degraded">
            <span class="pulse-dot"></span>
          </div>
        </div>
        <div class="metrics">
          <span class="metric-label">Latency</span>
          <span class="metric-value warning-text">340ms</span>
        </div>
      </div>
    </div>

    <div class="section chart-section">
      <div class="section-title">Response Times (Last 1h)</div>
      <div class="chart-container">
        <svg class="sparkline" viewBox="0 0 400 100" preserveAspectRatio="none">
          <!-- Grid lines -->
          <line x1="0" y1="25" x2="400" y2="25" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4" />
          <line x1="0" y1="50" x2="400" y2="50" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4" />
          <line x1="0" y1="75" x2="400" y2="75" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4" />
          
          <!-- Data line (Smooth curve approximation) -->
          <path d="M0 80 Q 20 82, 40 75 T 80 60 T 120 65 T 160 50 T 200 55 T 240 40 T 280 20 T 320 15 T 360 45 T 400 40" 
                fill="none" 
                stroke="var(--color-accent)" 
                stroke-width="2" 
                class="chart-line" />
                
          <!-- Search API spike marker -->
          <circle cx="280" cy="20" r="3" fill="#EAB308" />
        </svg>
      </div>
    </div>

    <div class="section alerts-section">
      <div class="section-title">Recent Alerts</div>
      <div class="alert-list">
        <div class="alert-item alert-warning">
          <span class="alert-icon">⚠</span>
          <span class="alert-msg">Search API latency &gt; 300ms</span>
          <span class="alert-time">2 min ago</span>
        </div>
        <div class="alert-item alert-success">
          <span class="alert-icon">✓</span>
          <span class="alert-msg">Payments API recovered</span>
          <span class="alert-time">14 min ago</span>
        </div>
        <div class="alert-item alert-muted">
          <span class="alert-icon">✓</span>
          <span class="alert-msg">All endpoints healthy</span>
          <span class="alert-time">1 hour ago</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dashboard-mock {
    background-color: var(--color-bg-card, #12141C);
    border: 1px solid var(--color-border, rgba(255,255,255,0.08));
    border-radius: 16px;
    box-shadow: inset 0 1px 0 var(--card-highlight, rgba(255,255,255,0.12)), 0 24px 48px -12px rgba(0,0,0,0.5);
    overflow: hidden;
    width: 100%;
    animation: float 6s ease-in-out infinite;
    color: var(--color-text-primary, #F8FAFC);
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
    100% { transform: translateY(0px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dashboard-mock {
      animation: none;
    }
  }

  .window-chrome {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(0,0,0,0.2);
    border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.08));
    position: relative;
  }

  .window-controls {
    display: flex;
    gap: 8px;
    position: absolute;
    left: 16px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.close { background-color: #EF4444; }
  .dot.minimize { background-color: #EAB308; }
  .dot.expand { background-color: #22C55E; }

  .window-title {
    width: 100%;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary, #94A3B8);
  }

  .dashboard-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .status-overview {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 4px; /* for focus rings/shadows */
  }

  .status-card {
    flex: 1;
    min-width: 140px;
    background-color: var(--color-bg-secondary, rgba(255,255,255,0.03));
    border: 1px solid var(--color-border, rgba(255,255,255,0.08));
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .status-card.warning {
    border-color: rgba(234, 179, 8, 0.3);
    background-color: rgba(234, 179, 8, 0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .api-name {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .status-indicator {
    position: relative;
    width: 8px;
    height: 8px;
  }

  .pulse-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .healthy .pulse-dot { background-color: #22C55E; }
  .degraded .pulse-dot { background-color: #EAB308; }

  .pulse-ring {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #22C55E;
    opacity: 0.4;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .metrics {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .metric-value {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .warning-text { color: #EAB308; }

  .chart-container {
    background-color: var(--color-bg-secondary, rgba(255,255,255,0.03));
    border: 1px solid var(--color-border);
    border-radius: 8px;
    height: 120px;
    padding: 16px 0;
    position: relative;
  }

  .sparkline {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .chart-line {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: drawLine 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.5s;
  }

  @keyframes drawLine {
    to { stroke-dashoffset: 0; }
  }

  .alert-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .alert-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background-color: var(--color-bg-secondary, rgba(255,255,255,0.03));
    border-radius: 8px;
    font-size: 0.875rem;
  }

  .alert-warning {
    border-left: 3px solid #EAB308;
  }

  .alert-warning .alert-icon { color: #EAB308; }

  .alert-success .alert-icon { color: #22C55E; }

  .alert-muted .alert-icon { color: var(--color-text-secondary); opacity: 0.5; }
  .alert-muted { opacity: 0.7; }

  .alert-msg {
    flex: 1;
    font-weight: 500;
  }

  .alert-time {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>
