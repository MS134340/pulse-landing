---
// Features.astro
---
<section id="features" class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">FEATURES</span>
      <h2>Everything you need to stay ahead of failures</h2>
    </div>

    <div class="features-grid">
      <div class="card feature-card reveal">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h3>Real-Time Monitoring</h3>
        <p>Sub-second health checks across all your endpoints. Know the moment something changes, not minutes later.</p>
      </div>

      <div class="card feature-card reveal">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <h3>Smart Alerts</h3>
        <p>Context-aware notifications that understand the difference between a blip and a real incident. Slack, email, PagerDuty.</p>
      </div>

      <div class="card feature-card reveal">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </div>
        <h3>Team Dashboards</h3>
        <p>Shared visibility for your entire team. Custom views for engineering, product, and leadership. One source of truth.</p>
      </div>

      <div class="card feature-card reveal">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>Incident Timeline</h3>
        <p>Automatic incident detection and timeline construction. See exactly what happened, when, and what recovered.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const handleMouseMove = (e: MouseEvent) => {
    const cards = document.querySelectorAll('.feature-card') as NodeListOf<HTMLElement>;
    for (const card of cards) {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    }
  };
  
  const featuresSection = document.getElementById('features');
  if (featuresSection) {
    featuresSection.addEventListener('mousemove', handleMouseMove);
  }
</script>

<style>
  .section {
    padding: 96px 0;
    background-color: var(--color-bg-primary);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 16px;
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 32px;
    box-shadow: inset 0 1px 0 var(--card-highlight), var(--shadow-sm);
    position: relative;
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out-expo);
  }
  .feature-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      600px circle at var(--mouse-x, 0) var(--mouse-y, 0),
      rgba(255, 255, 255, 0.08),
      transparent 40%
    );
    z-index: 0;
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    pointer-events: none;
  }
  .feature-card:hover::before {
    opacity: 1;
  }
  .feature-card:hover {
    border-color: var(--color-border-hover);
  }
  .card-icon {
    width: 24px;
    height: 24px;
    color: var(--color-accent);
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }
  .card h3 {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }
  .card p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }
</style>
