---
---

<section id="product-showcase" class="section showcase-section">
  <div class="container">
    <div class="showcase-header reveal">
      <span class="eyebrow">Product Preview</span>
      <h2>Built for the way your team actually works</h2>
      <p class="showcase-subtitle">
        A shared command center for API health. No more jumping between tabs, 
        Slack threads, and status pages.
      </p>
    </div>

    <div class="showcase-dashboard reveal">
      <div class="showcase-window">
        <!-- Browser chrome -->
        <div class="window-bar">
          <div class="window-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="window-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="6,12 9,12 11,8 13,16 15,12 18,12" fill="none"/>
            </svg>
            <span>app.getpulse.dev</span>
          </div>
          <div class="window-actions">
            <span class="tab active">Overview</span>
            <span class="tab">Endpoints</span>
            <span class="tab">Alerts</span>
          </div>
        </div>

        <!-- Dashboard content -->
        <div class="dashboard-body">
          <!-- Top metrics row -->
          <div class="metrics-row">
            <div class="metric-card">
              <span class="metric-label">Uptime (30d)</span>
              <span class="metric-value metric-green">99.97%</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Avg Response</span>
              <span class="metric-value">84ms</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Endpoints</span>
              <span class="metric-value">12</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Incidents (7d)</span>
              <span class="metric-value metric-green">0</span>
            </div>
          </div>

          <!-- Main content grid -->
          <div class="dashboard-grid">
            <!-- Left: endpoint list -->
            <div class="endpoint-list">
              <div class="list-header">
                <span>Endpoint</span>
                <span>Status</span>
                <span>Latency</span>
                <span>Uptime</span>
              </div>
              <div class="endpoint-row">
                <span class="ep-name"><span class="method get">GET</span> /api/users</span>
                <span class="status-badge healthy">Healthy</span>
                <span class="ep-latency">23ms</span>
                <span class="ep-uptime">100%</span>
              </div>
              <div class="endpoint-row">
                <span class="ep-name"><span class="method post">POST</span> /api/payments</span>
                <span class="status-badge healthy">Healthy</span>
                <span class="ep-latency">45ms</span>
                <span class="ep-uptime">99.99%</span>
              </div>
              <div class="endpoint-row highlight">
                <span class="ep-name"><span class="method get">GET</span> /api/search</span>
                <span class="status-badge degraded">Degraded</span>
                <span class="ep-latency warn">340ms</span>
                <span class="ep-uptime">99.87%</span>
              </div>
              <div class="endpoint-row">
                <span class="ep-name"><span class="method get">GET</span> /api/products</span>
                <span class="status-badge healthy">Healthy</span>
                <span class="ep-latency">31ms</span>
                <span class="ep-uptime">100%</span>
              </div>
              <div class="endpoint-row">
                <span class="ep-name"><span class="method post">POST</span> /api/auth</span>
                <span class="status-badge healthy">Healthy</span>
                <span class="ep-latency">67ms</span>
                <span class="ep-uptime">99.98%</span>
              </div>
            </div>

            <!-- Right: response time chart -->
            <div class="chart-panel">
              <div class="chart-header">
                <span class="chart-title">Response Time (24h)</span>
                <span class="chart-legend"><span class="legend-dot"></span> /api/search</span>
              </div>
              <div class="chart-area">
                <svg viewBox="0 0 400 120" preserveAspectRatio="none" class="sparkline-chart">
                  <!-- Grid lines -->
                  <line x1="0" y1="30" x2="400" y2="30" class="grid-line"/>
                  <line x1="0" y1="60" x2="400" y2="60" class="grid-line"/>
                  <line x1="0" y1="90" x2="400" y2="90" class="grid-line"/>
                  
                  <!-- Area fill -->
                  <path d="M0,80 L30,78 L60,75 L90,72 L120,70 L150,68 L180,65 L200,60 L220,50 L240,35 L260,30 L280,25 L300,28 L310,32 L320,38 L340,42 L360,35 L380,30 L400,28 L400,120 L0,120 Z" 
                        class="chart-fill"/>
                  
                  <!-- Line -->
                  <polyline points="0,80 30,78 60,75 90,72 120,70 150,68 180,65 200,60 220,50 240,35 260,30 280,25 300,28 310,32 320,38 340,42 360,35 380,30 400,28" 
                            class="chart-line"
                            stroke-dasharray="800"
                            stroke-dashoffset="800"/>
                </svg>
                <!-- Y-axis labels -->
                <div class="y-labels">
                  <span>400ms</span>
                  <span>300ms</span>
                  <span>200ms</span>
                  <span>100ms</span>
                </div>
                <!-- X-axis labels -->
                <div class="x-labels">
                  <span>00:00</span>
                  <span>06:00</span>
                  <span>12:00</span>
                  <span>18:00</span>
                  <span>Now</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-section {
    position: relative;
    overflow: hidden;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .showcase-header h2 {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .showcase-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0 auto;
  }

  .showcase-dashboard {
    position: relative;
  }

  .showcase-window {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: var(--card-highlight), var(--shadow-lg);
    overflow: hidden;
  }

  /* Window chrome */
  .window-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #EF4444; }
  .dot-yellow { background: #EAB308; }
  .dot-green { background: #22C55E; }

  .window-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    background: var(--color-bg-primary);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .window-actions {
    display: flex;
    gap: 0;
    margin-left: auto;
  }

  .tab {
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    cursor: default;
  }

  .tab.active {
    color: var(--color-text-primary);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-sm);
  }

  /* Dashboard body */
  .dashboard-body {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }

  /* Metrics row */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .metric-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--card-highlight);
  }

  .metric-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .metric-value {
    font-size: var(--font-size-xl);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .metric-green {
    color: var(--color-green);
  }

  /* Dashboard grid */
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1rem;
  }

  /* Endpoint list */
  .endpoint-list {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--card-highlight);
  }

  .list-header {
    display: grid;
    grid-template-columns: 2fr 1fr 0.8fr 0.8fr;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
  }

  .endpoint-row {
    display: grid;
    grid-template-columns: 2fr 1fr 0.8fr 0.8fr;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--font-size-sm);
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) var(--ease-out-expo);
  }

  .endpoint-row:last-child {
    border-bottom: none;
  }

  .endpoint-row.highlight {
    background: rgba(234, 179, 8, 0.05);
  }

  .ep-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
  }

  .method {
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .method.get {
    background: rgba(34, 197, 94, 0.12);
    color: var(--color-green);
  }

  .method.post {
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-accent);
  }

  .status-badge {
    font-size: var(--font-size-xs);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .status-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .status-badge.healthy {
    color: var(--color-green);
  }

  .status-badge.healthy::before {
    background: var(--color-green);
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .status-badge.degraded {
    color: var(--color-yellow);
  }

  .status-badge.degraded::before {
    background: var(--color-yellow);
    box-shadow: 0 0 6px rgba(234, 179, 8, 0.5);
    animation: pulse-dot 1.5s ease-in-out infinite;
  }

  .ep-latency {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  .ep-latency.warn {
    color: var(--color-yellow);
    font-weight: 600;
  }

  .ep-uptime {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  /* Chart panel */
  .chart-panel {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    box-shadow: var(--card-highlight);
    display: flex;
    flex-direction: column;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .chart-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .chart-legend {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .chart-area {
    position: relative;
    flex: 1;
    min-height: 100px;
  }

  .sparkline-chart {
    width: 100%;
    height: 100%;
  }

  .grid-line {
    stroke: var(--color-border);
    stroke-width: 0.5;
  }

  .chart-fill {
    fill: var(--color-accent);
    opacity: 0.08;
  }

  .chart-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .showcase-dashboard.visible .chart-line {
    animation: sparkline-draw 2s var(--ease-out-expo) forwards;
  }

  .y-labels {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.5625rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    pointer-events: none;
    padding: 0.125rem 0;
  }

  .x-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.5625rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-top: 0.375rem;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .metrics-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .window-actions {
      display: none;
    }

    .window-title {
      display: none;
    }

    .list-header,
    .endpoint-row {
      grid-template-columns: 1.5fr 1fr 0.8fr;
    }

    .list-header span:last-child,
    .endpoint-row span:last-child {
      display: none;
    }

    .endpoint-row {
      font-size: var(--font-size-xs);
    }
  }

  @media (max-width: 480px) {
    .metrics-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .metric-value {
      font-size: var(--font-size-lg);
    }
  }
</style>

<script>
  // Animate chart line when showcase comes into view
  const showcase = document.querySelector('.showcase-dashboard');
  if (showcase) {
    const chartObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            chartObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    chartObserver.observe(showcase);
  }
</script>
